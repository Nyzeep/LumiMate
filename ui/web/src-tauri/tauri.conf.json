{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumiMate",
  "version": "0.2.0",
  "identifier": "com.nyzeep.lumimate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
